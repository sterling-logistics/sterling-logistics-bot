<Window x:Class="Sterling.Logistics.Tracker.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sterling Tracker" Width="1180" Height="720" MinWidth="980" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="{StaticResource SterlingBackground}">
 <Grid Margin="36">
  <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Margin="28">
   <TextBlock Text="STERLING LOGISTICS" Foreground="{StaticResource SterlingMuted}" FontSize="15" FontWeight="SemiBold"/>
   <TextBlock Text="Sterling Tracker" Foreground="White" FontSize="52" FontWeight="Bold" Margin="0,12,0,8"/>
   <TextBlock Text="Professional driver operations for Euro Truck Simulator 2 and American Truck Simulator." Foreground="{StaticResource SterlingMuted}" FontSize="18" TextWrapping="Wrap" MaxWidth="560"/>
   <Border Margin="0,38,0,0" Padding="18" Background="{StaticResource SterlingPanel}" CornerRadius="14" MaxWidth="560" HorizontalAlignment="Left">
    <StackPanel><TextBlock Text="SYSTEM STATUS" Foreground="{StaticResource SterlingMuted}" FontWeight="SemiBold"/><TextBlock Text="Secure connection required before driver operations begin." Foreground="White" Margin="0,7,0,0"/></StackPanel>
   </Border>
  </StackPanel>
  <Border Grid.Column="1" Background="{StaticResource SterlingPanel}" CornerRadius="22" Padding="38" MaxWidth="430" VerticalAlignment="Center">
   <StackPanel>
    <TextBlock Text="Driver sign in" Foreground="White" FontSize="30" FontWeight="Bold"/>
    <TextBlock Text="Use the Sterling account issued by staff." Foreground="{StaticResource SterlingMuted}" Margin="0,8,0,28"/>
    <TextBlock Text="Username" Foreground="{StaticResource SterlingAccent}" FontWeight="SemiBold"/>
    <TextBox x:Name="UsernameBox" Height="44" Margin="0,8,0,18" FontSize="16" Padding="12,8"/>
    <TextBlock Text="Password" Foreground="{StaticResource SterlingAccent}" FontWeight="SemiBold"/>
    <PasswordBox x:Name="PasswordBox" Height="44" Margin="0,8,0,12" FontSize="16" Padding="12,8"/>
    <CheckBox x:Name="RememberMeBox" Content="Keep me signed in securely" Foreground="{StaticResource SterlingMuted}" Margin="0,4,0,22"/>
    <Button x:Name="SignInButton" Content="Sign in to Sterling" Height="48" FontSize="16" FontWeight="SemiBold" Click="SignInButton_Click"/>
    <TextBlock x:Name="StatusText" Foreground="{StaticResource SterlingMuted}" TextWrapping="Wrap" Margin="0,18,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
