<Window x:Class="Sterling.Logistics.ControlCentre.OwnerDataWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sterling Control Centre · Operations" Width="1420" Height="860" MinWidth="1150" MinHeight="700"
 WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="Owner Operations" Foreground="White" FontSize="28" FontWeight="Bold"/>
    <TextBlock Text="Drivers, jobs, approvals, payments, audit and system health" Foreground="{StaticResource Muted}"/>
   </StackPanel>
   <Button DockPanel.Dock="Right" Content="Refresh" Width="110" Height="34" Click="RefreshButton_Click"/>
  </DockPanel>

  <TabControl Grid.Row="1" x:Name="Tabs" Background="{StaticResource Panel}" Foreground="White" SelectionChanged="Tabs_SelectionChanged">
   <TabItem Header="Drivers">
    <Grid Margin="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <DataGrid x:Name="DriversGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DriversGrid_SelectionChanged">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Driver" Binding="{Binding DisplayName}" Width="*"/>
       <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
       <DataGridTextColumn Header="Rank" Binding="{Binding RankName}" Width="150"/>
       <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
      </DataGrid.Columns>
     </DataGrid>
     <Grid Grid.Column="1" Margin="14,0,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="DriverStatsText" Text="Select a driver to view history." Foreground="White" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <DataGrid Grid.Row="1" x:Name="DriverHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="145"/>
        <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="*"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
        <DataGridTextColumn Header="Payout" Binding="{Binding PayoutAmount, StringFormat={}{0:0}}" Width="90"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Grid>
   </TabItem>

   <TabItem Header="Jobs">
    <DataGrid x:Name="JobsGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Driver" Binding="{Binding DriverDisplayName}" Width="180"/>
      <DataGridTextColumn Header="Game" Binding="{Binding Game}" Width="80"/>
      <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="180"/>
      <DataGridTextColumn Header="Origin" Binding="{Binding OriginCity}" Width="150"/>
      <DataGridTextColumn Header="Destination" Binding="{Binding DestinationCity}" Width="150"/>
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
      <DataGridTextColumn Header="Payout" Binding="{Binding PayoutAmount, StringFormat={}{0:0}}" Width="90"/>
      <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="150"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>

   <TabItem Header="Approvals">
    <Grid Margin="12">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DataGrid x:Name="ApprovalsGrid" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Driver" Binding="{Binding DriverDisplayName}" Width="180"/>
       <DataGridTextColumn Header="Game" Binding="{Binding Game}" Width="80"/>
       <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="180"/>
       <DataGridTextColumn Header="Origin" Binding="{Binding OriginCity}" Width="150"/>
       <DataGridTextColumn Header="Destination" Binding="{Binding DestinationCity}" Width="150"/>
       <DataGridTextColumn Header="Distance" Binding="{Binding DistanceKm, StringFormat={}{0:0} km}" Width="100"/>
       <DataGridTextColumn Header="Payout" Binding="{Binding PayoutAmount, StringFormat={}{0:0}}" Width="100"/>
       <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedAt, StringFormat={}{0:g}}" Width="150"/>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBox x:Name="ReviewNotesBox" Width="320" Height="34" Margin="0,0,8,0" Padding="8" ToolTip="Optional review note"/>
      <Button Content="Decline" Width="100" Height="34" Margin="0,0,8,0" Click="DeclineButton_Click"/>
      <Button Content="Approve" Width="100" Height="34" Click="ApproveButton_Click"/>
     </StackPanel>
    </Grid>
   </TabItem>

   <TabItem Header="Payments">
    <DataGrid x:Name="PayoutsGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Driver" Binding="{Binding DriverDisplayName}" Width="180"/>
      <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:0}}" Width="100"/>
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
      <DataGridTextColumn Header="Attempts" Binding="{Binding AttemptCount}" Width="80"/>
      <DataGridTextColumn Header="Before" Binding="{Binding BalanceBefore, StringFormat={}{0:0}}" Width="110"/>
      <DataGridTextColumn Header="After" Binding="{Binding BalanceAfter, StringFormat={}{0:0}}" Width="110"/>
      <DataGridTextColumn Header="Error" Binding="{Binding LastError}" Width="*"/>
      <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="150"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>

   <TabItem Header="Audit Logs">
    <DataGrid x:Name="AuditGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Time" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="155"/>
      <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="230"/>
      <DataGridTextColumn Header="Actor" Binding="{Binding ActorDisplayName}" Width="180"/>
      <DataGridTextColumn Header="Target" Binding="{Binding TargetDisplayName}" Width="180"/>
      <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="120"/>
      <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>

   <TabItem Header="System">
    <Grid Margin="24">
     <StackPanel>
      <TextBlock Text="Platform Health" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>
      <UniformGrid Columns="4">
       <Border Background="#101B2C" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="API" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SystemApiText" Text="—" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
       <Border Background="#101B2C" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="DATABASE" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SystemDatabaseText" Text="—" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
       <Border Background="#101B2C" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="JOBS" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SystemJobsText" Text="—" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
       <Border Background="#101B2C" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="FAILED PAYOUTS" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SystemFailedText" Text="—" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
      </UniformGrid>
      <TextBlock x:Name="SystemDetailText" Foreground="{StaticResource Muted}" Margin="0,18,0,0" FontSize="14"/>
     </StackPanel>
    </Grid>
   </TabItem>
  </TabControl>

  <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,12,0,0" Text="Ready."/>
 </Grid>
</Window>
