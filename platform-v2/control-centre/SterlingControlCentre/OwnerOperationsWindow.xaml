<Window x:Class="Sterling.Logistics.ControlCentre.OwnerOperationsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sterling Owner Operations" Width="1120" Height="720" MinWidth="980" MinHeight="650"
 WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="OWNER / FOUNDER OPERATIONS" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
   <TextBlock Text="Driver Accounts &amp; Job Control" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,6,0,20"/>
  </StackPanel>
  <TabControl Grid.Row="1" Background="{StaticResource Panel}" BorderThickness="0">
   <TabItem Header="Create Driver">
    <Grid Margin="22">
     <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Display name" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="DriverDisplayNameBox" Height="36" Margin="0,5" Padding="8"/>
     <TextBlock Grid.Row="1" Text="Username" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="DriverUsernameBox" Height="36" Margin="0,5" Padding="8"/>
     <TextBlock Grid.Row="2" Text="Password" Foreground="White" VerticalAlignment="Center"/><PasswordBox Grid.Row="2" Grid.Column="1" x:Name="DriverPasswordBox" Height="36" Margin="0,5" Padding="8"/>
     <TextBlock Grid.Row="3" Text="Rank" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="DriverRankBox" Text="Driver" Height="36" Margin="0,5" Padding="8"/>
     <Button Grid.Row="4" Grid.Column="1" x:Name="CreateDriverButton" Content="Create Sterling Driver Account" Height="42" Margin="0,18,0,0" Click="CreateDriverButton_Click"/>
     <TextBlock Grid.Column="2" Grid.RowSpan="5" Margin="35,5,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Only the Owner/Founder can create credentials. Drivers cannot change their own Sterling password. Passwords are stored as secure one-way hashes; use the reset control when you need to issue a new password."/>
    </Grid>
   </TabItem>
   <TabItem Header="Drivers">
    <Grid Margin="22">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DataGrid x:Name="OwnerDriversGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
      <DataGrid.Columns>
       <DataGridTextColumn Header="NAME" Binding="{Binding DisplayName}" Width="*"/>
       <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="180"/>
       <DataGridTextColumn Header="RANK" Binding="{Binding RankName}" Width="160"/>
       <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="90"/>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
      <PasswordBox x:Name="ResetPasswordBox" Width="250" Height="36" Padding="8" ToolTip="New password (minimum 12 characters)"/>
      <Button Content="Set New Password" Margin="10,0,0,0" Width="150" Click="ResetPasswordButton_Click"/>
      <Button Content="Enable" Margin="10,0,0,0" Width="100" Click="EnableDriverButton_Click"/>
      <Button Content="Disable" Margin="10,0,0,0" Width="100" Click="DisableDriverButton_Click"/>
      <Button Content="Refresh" Margin="10,0,0,0" Width="100" Click="RefreshDriversButton_Click"/>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Create Job">
    <Grid Margin="22">
     <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Driver" Foreground="White" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="JobDriverBox" Height="36" Margin="0,5" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
     <TextBlock Grid.Row="1" Text="Game" Foreground="White" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="GameBox" Height="36" Margin="0,5" SelectedIndex="0"><ComboBoxItem Content="ETS2" Tag="ets2"/><ComboBoxItem Content="ATS" Tag="ats"/></ComboBox>
     <TextBlock Grid.Row="2" Text="Cargo" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="CargoBox" Height="36" Margin="0,5" Padding="8"/>
     <TextBlock Grid.Row="3" Text="Origin" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="OriginBox" Height="36" Margin="0,5" Padding="8"/>
     <TextBlock Grid.Row="4" Text="Destination" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="DestinationBox" Height="36" Margin="0,5" Padding="8"/>
     <TextBlock Grid.Row="5" Text="Distance (km)" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" x:Name="DistanceBox" Height="36" Margin="0,5" Padding="8"/>
     <TextBlock Grid.Row="6" Text="Payout amount" Foreground="White" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" x:Name="PayoutBox" Height="36" Margin="0,5" Padding="8"/>
     <Button Grid.Row="7" Grid.Column="1" Content="Create &amp; Assign Job" Height="42" Margin="0,18,0,0" Click="CreateJobButton_Click"/>
     <TextBlock Grid.Column="2" Grid.RowSpan="8" Margin="35,5,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Jobs created here are assigned through the Sterling API. Owner/Founder jobs auto-approve after a valid delivery submission; normal driver jobs enter your approval queue."/>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" x:Name="OwnerOpsStatusText" Foreground="{StaticResource Muted}" Margin="0,14,0,0" Text="Owner controls ready."/>
 </Grid>
</Window>
