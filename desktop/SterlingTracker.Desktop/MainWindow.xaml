<Window x:Class="SterlingTracker.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sterling Tracker" Height="760" Width="1120" MinHeight="700" MinWidth="980" WindowStartupLocation="CenterScreen" Background="#050B14" Foreground="#F7FAFF" Icon="Assets/SterlingTracker.ico">
<Window.Resources>
  <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="#0B1524"/><Setter Property="BorderBrush" Value="#1A2B43"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#1177EE"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBlock" x:Key="Label"><Setter Property="Foreground" Value="#6D87A5"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
</Window.Resources>
<Grid Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="68" Height="68" CornerRadius="15" Background="#07101D" BorderBrush="#244568" BorderThickness="1" Padding="5">
      <Image Source="Assets/SterlingTracker.ico" Stretch="Uniform"/>
    </Border>
    <StackPanel Grid.Column="1" Margin="16,5,0,0"><TextBlock Text="STERLING TRACKER" FontSize="30" FontWeight="Bold"/><TextBlock Text="OFFICIAL STERLING LOGISTICS DRIVER CLIENT" Foreground="#55A9FF" FontSize="12" FontWeight="SemiBold" Margin="1,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="v1.2" Foreground="#6D87A5" HorizontalAlignment="Right"/><TextBlock Text="SECURE DESKTOP SESSION" Foreground="#3B5878" FontSize="10" Margin="0,4,0,0"/></StackPanel>
  </Grid>

  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,14">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="StatusText" Text="● Sterling account not connected" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="AccountText" Text="Sign in with Discord to link your approved Sterling driver profile" Foreground="#A5B7CB" Margin="0,7,0,0"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock x:Name="GameText" Text="ETS2 not detected" Foreground="#7088A4"/><TextBlock Text="   •   " Foreground="#3E5771"/><TextBlock x:Name="TelemetryText" Text="Telemetry waiting" Foreground="#7088A4"/></StackPanel></StackPanel>
      <Button Grid.Column="1" x:Name="AccountButton" Content="Sign in with Discord" Click="AccountButton_Click" VerticalAlignment="Center"/>
    </Grid>
  </Border>

  <Grid Grid.Row="2" Margin="0,0,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,9,0" Padding="16"><StackPanel><TextBlock Text="SPEED" Style="{StaticResource Label}"/><TextBlock x:Name="SpeedText" Text="0 mph" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,6,0" Padding="16"><StackPanel><TextBlock Text="SPEED LIMIT" Style="{StaticResource Label}"/><TextBlock x:Name="SpeedLimitText" Text="—" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,3,0" Padding="16"><StackPanel><TextBlock Text="FUEL" Style="{StaticResource Label}"/><TextBlock x:Name="FuelText" Text="—" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
    <Border Grid.Column="3" Style="{StaticResource Card}" Margin="9,0,0,0" Padding="16"><StackPanel><TextBlock Text="DAMAGE" Style="{StaticResource Label}"/><TextBlock x:Name="DamageText" Text="—" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
  </Grid>

  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="CURRENT DELIVERY" Foreground="#55A9FF" FontWeight="Bold"/>
      <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock x:Name="CargoText" Text="No active delivery" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="RouteText" Text="—  →  —" FontSize="20" Foreground="#C9D7E8" Margin="0,10,0,0" TextWrapping="Wrap"/><Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PLANNED DISTANCE" Style="{StaticResource Label}"/><TextBlock x:Name="DistanceText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="JOB VALUE" Style="{StaticResource Label}"/><TextBlock x:Name="JobValueText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="TRACKING" Style="{StaticResource Label}"/><TextBlock x:Name="JobStateText" Text="Waiting" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid></StackPanel>
      <Border Grid.Row="2" Background="#08111E" CornerRadius="10" Padding="14" Margin="0,20,0,0"><TextBlock Text="Jobs  fuel stops  fines  crashes  rests  mileage  driving time and company earnings are recorded automatically" Foreground="#748DA8" TextWrapping="Wrap"/></Border>
    </Grid></Border>

    <StackPanel Grid.Column="1" Margin="10,0,0,0">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DRIVER PROFILE" Foreground="#55A9FF" FontWeight="Bold"/><TextBlock x:Name="DriverNameText" Text="Not signed in" FontSize="22" FontWeight="SemiBold" Margin="0,17,0,4" TextWrapping="Wrap"/><TextBlock x:Name="DriverIdText" Text="—" Foreground="#A5B7CB"/><Separator Margin="0,17" Background="#1A2B43"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RANK" Style="{StaticResource Label}"/><TextBlock x:Name="RankText" Text="—" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="STATUS" Style="{StaticResource Label}"/><TextBlock x:Name="ConnectionText" Text="Offline" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="TRUCK" Foreground="#55A9FF" FontWeight="Bold"/><TextBlock x:Name="TruckText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock Text="Sterling Secure Telemetry" Foreground="#617B98" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
    </StackPanel>
  </Grid>

  <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterText" Text="Sterling Tracker is ready" Foreground="#7088A4" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Built for Sterling Logistics" Foreground="#405873"/></Grid>
</Grid>
</Window>