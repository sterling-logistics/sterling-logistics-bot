<Window x:Class="SterlingTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sterling Tracker"
        Height="840" Width="1320" MinHeight="760" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#060A11" Foreground="#F6F9FC"
        Icon="Assets/SterlingTracker.ico"
        FontFamily="Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#070B12" Offset="0"/>
            <GradientStop Color="#0A1421" Offset="0.56"/>
            <GradientStop Color="#07111C" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#12243A" Offset="0"/>
            <GradientStop Color="#0B1727" Offset="0.55"/>
            <GradientStop Color="#091321" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D8FFF" Offset="0"/>
            <GradientStop Color="#65B9FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#0D1724"/>
            <Setter Property="BorderBrush" Value="#1A2B40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="MetricPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6F89A7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="90"/>
        </Style>

        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8196AE"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1687F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Background="#080D15" BorderBrush="#172536" BorderThickness="0,0,1,0">
            <Grid Margin="20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="70" Height="70" CornerRadius="18" Background="#0D1826" BorderBrush="#264968" BorderThickness="1" Padding="6" HorizontalAlignment="Left">
                        <Image Source="Assets/SterlingTracker.ico" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="STERLING" FontSize="22" FontWeight="Bold" Margin="0,14,0,0"/>
                    <TextBlock Text="TRACKER" FontSize="12" Foreground="#4EA8FF" FontWeight="SemiBold" CharacterSpacing="120"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Border Background="#12243A" CornerRadius="10" Padding="12,10" BorderBrush="#244866" BorderThickness="1">
                        <TextBlock Text="Dashboard" Foreground="#F5FAFF" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Live Drive" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="Current Job" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="Driver Profile" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="DriveScore" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="Career &amp; Pay" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                </StackPanel>

                <Border Grid.Row="3" Background="#0C1622" BorderBrush="#182A3E" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="STERLING NETWORK" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Secure telemetry" Foreground="#CAD7E5" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        <TextBlock Text="Encrypted desktop session" Foreground="#667D96" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main application -->
        <Grid Grid.Column="1" Margin="28,24,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Driver Operations" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Live ETS2 telemetry and Sterling Logistics operations" Foreground="#7188A2" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0D1926" BorderBrush="#1B3248" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,12,0">
                        <TextBlock Text="v1.2" Foreground="#7890AA" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="AccountButton" Content="Sign in with Discord" Click="AccountButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Connection status banner -->
            <Border Grid.Row="1" Margin="0,20,0,14" CornerRadius="16" BorderBrush="#1F3851" BorderThickness="1" Padding="18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#10243A" Offset="0"/>
                        <GradientStop Color="#0B1624" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" Background="#112C43" BorderBrush="#2D6C98" BorderThickness="1">
                        <TextBlock Text="●" Foreground="#38C989" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Sterling account not connected" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AccountText" Text="Sign in with Discord to link your approved Sterling driver profile" Foreground="#8096AE" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="GameText" Text="ETS2 not detected" Foreground="#A4B5C7" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TelemetryText" Text="Telemetry waiting" Foreground="#647C95" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live metric strip -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricPanel}" Margin="0,0,7,0">
                    <StackPanel><TextBlock Text="LIVE SPEED" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="SpeedText" Text="0 mph" FontSize="31" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Vehicle speed" Foreground="#536A82" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricPanel}" Margin="7,0">
                    <StackPanel><TextBlock Text="SPEED LIMIT" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="SpeedLimitText" Text="—" FontSize="31" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Current road" Foreground="#536A82" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricPanel}" Margin="7,0">
                    <StackPanel><TextBlock Text="FUEL" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="FuelText" Text="—" FontSize="31" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Tank remaining" Foreground="#536A82" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricPanel}" Margin="7,0,0,0">
                    <StackPanel><TextBlock Text="TRUCK DAMAGE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="DamageText" Text="—" FontSize="31" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Highest component" Foreground="#536A82" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                </Border>
            </Grid>

            <!-- Main dashboard -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="0.82*"/></Grid.ColumnDefinitions>

                <Border Margin="0,0,9,0" CornerRadius="20" BorderBrush="#24405A" BorderThickness="1" Padding="26" Background="{StaticResource HeroBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CURRENT DELIVERY" Foreground="#55B0FF" FontWeight="Bold" FontSize="12" CharacterSpacing="90"/>
                                <TextBlock x:Name="CargoText" Text="No active delivery" FontSize="32" FontWeight="SemiBold" Margin="0,13,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#10253A" BorderBrush="#225074" BorderThickness="1" CornerRadius="9" Padding="11,7" VerticalAlignment="Top">
                                <TextBlock x:Name="JobStateText" Text="Waiting" Foreground="#8DCAFF" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" x:Name="RouteText" Text="—  →  —" FontSize="22" Foreground="#C8D7E6" Margin="0,15,0,0" TextWrapping="Wrap"/>

                        <Grid Grid.Row="2" Margin="0,30,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PLANNED DISTANCE" Style="{StaticResource Eyebrow}"/>
                                <TextBlock x:Name="DistanceText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="JOB VALUE" Style="{StaticResource Eyebrow}"/>
                                <TextBlock x:Name="JobValueText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DRIVER SHARE" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="35%" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0" Foreground="#55B0FF"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" Background="#09121E" CornerRadius="12" BorderBrush="#172A3E" BorderThickness="1" Padding="15" Margin="0,24,0,0">
                            <TextBlock Text="Automatic tracking active for jobs  fuel  fines  incidents  rests  mileage  driving time and company earnings" Foreground="#6F879F" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="9,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="DRIVER PROFILE" Foreground="#55B0FF" FontWeight="Bold" FontSize="12" CharacterSpacing="90"/>
                            <TextBlock x:Name="DriverNameText" Text="Not signed in" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,4" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DriverIdText" Text="—" Foreground="#8CA1B7"/>
                            <Border Height="1" Background="#1A2B40" Margin="0,20,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="RANK" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="RankText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="CONNECTION" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="ConnectionText" Text="Offline" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="#55B0FF"/></StackPanel>
                            </Grid>
                            <Border Background="#09131F" BorderBrush="#172A3D" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="ASSIGNED TRUCK" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="TruckText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="17">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="STERLING SECURE TELEMETRY" Style="{StaticResource Eyebrow}"/><TextBlock Text="Live operations link" Foreground="#B9C8D8" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <TextBlock Grid.Column="1" Text="●" Foreground="#39C987" FontSize="18" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,17,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="Sterling Tracker is ready" Foreground="#667E97" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="STERLING LOGISTICS  •  BUILT ON TRUST  DRIVEN BY EXCELLENCE" Foreground="#3F566E" FontSize="10" CharacterSpacing="80"/>
            </Grid>
        </Grid>
    </Grid>
</Window>