<Window x:Class="SterlingTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sterling Tracker"
        Height="900" Width="1500" MinHeight="800" MinWidth="1220"
        WindowStartupLocation="CenterScreen"
        Background="#050A10" Foreground="#F4F8FC"
        Icon="Assets/SterlingTracker.ico"
        FontFamily="Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#050A10" Offset="0"/>
            <GradientStop Color="#07111C" Offset="0.5"/>
            <GradientStop Color="#06101A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D2135" Offset="0"/>
            <GradientStop Color="#0A1725" Offset="0.55"/>
            <GradientStop Color="#07121D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ConnectedBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#073124" Offset="0"/>
            <GradientStop Color="#08251F" Offset="0.4"/>
            <GradientStop Color="#091722" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#0A1521"/>
            <Setter Property="BorderBrush" Value="#183049"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="MetricPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64B4FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#71869C"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AAFC4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#126FE8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#050B12" BorderBrush="#132436" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center">
                    <Image Source="Assets/SterlingTracker.ico" Width="112" Height="112" Stretch="Uniform"/>
                    <TextBlock Text="STERLING" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="LOGISTICS TRACKER" Foreground="#2B9CFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <Border Background="#0D2A49" BorderBrush="#1C67A8" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <TextBlock Text="⌂   Dashboard" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="◉   Live Drive" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="▣   Current Job" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="●   Driver Profile" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="★   DriveScore" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="☰   Jobs History" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="£   Finances" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="♚   Convoys" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                    <TextBlock Text="⚙   Settings" Style="{StaticResource NavText}" Margin="12,17,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Background="#08141E" BorderBrush="#15334C" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="●  STERLING CONNECTED" Foreground="#35D68B" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="All systems operational" Foreground="#B8C8D8" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#08141E" BorderBrush="#15334C" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="TELEMETRY" Style="{StaticResource Eyebrow}"/>
                                <TextBlock x:Name="LiveStateText" Grid.Column="1" Text="WAITING" Foreground="#36D98C" FontWeight="Bold" FontSize="10"/>
                            </Grid>
                            <TextBlock Text="Live data streaming" Foreground="#B8C8D8" Margin="0,7,0,0"/>
                            <TextBlock x:Name="PingText" Text="—" Foreground="#36D98C" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v1.3.0  •  Built on trust" Foreground="#526A82" FontSize="10" Margin="6,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,30,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="Live ETS2 telemetry and Sterling Logistics operations" Foreground="#8095A9" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0A1622" BorderBrush="#183149" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,12,0">
                        <TextBlock Text="v1.3.0" Foreground="#91A6BA" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="AccountButton" Content="Sign in with Discord" Click="AccountButton_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,17,0,13" Background="{StaticResource ConnectedBrush}" BorderBrush="#13503E" BorderThickness="1" CornerRadius="15" Padding="17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="21" Background="#0A4933" BorderBrush="#19B878" BorderThickness="1">
                        <TextBlock Text="✓" Foreground="#41E89A" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,22,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Sterling account not connected" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AccountText" Text="Sign in with Discord to link your approved Sterling driver profile" Foreground="#93A9BA" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#091A22" BorderBrush="#17423C" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="6,0">
                        <TextBlock x:Name="GameText" Text="ETS2 not detected" Foreground="#D7E3EC" FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Column="3" Background="#091A22" BorderBrush="#17423C" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="6,0">
                        <TextBlock x:Name="TelemetryText" Text="Telemetry waiting" Foreground="#36D98C" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Column="4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LAST UPDATE" Foreground="#5C7890" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="LastUpdatedText" Text="—" Foreground="#9CB1C5" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricPanel}" Margin="0,0,6,0">
                    <StackPanel><TextBlock Text="SPEED" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="SpeedText" Text="0 mph" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Vehicle speed" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricPanel}" Margin="6,0">
                    <StackPanel><TextBlock Text="ENGINE RPM" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="RpmText" Text="0" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="rpm" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricPanel}" Margin="6,0">
                    <StackPanel><TextBlock Text="SPEED LIMIT" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="SpeedLimitText" Text="—" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Current road" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricPanel}" Margin="6,0">
                    <StackPanel><TextBlock Text="FUEL" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="FuelText" Text="—" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Tank remaining" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricPanel}" Margin="6,0">
                    <StackPanel><TextBlock Text="DAMAGE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="DamageText" Text="—" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Vehicle condition" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource MetricPanel}" Margin="6,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="CRUISE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="CruiseText" Text="OFF" FontSize="22" FontWeight="Bold" Margin="0,7,0,0" Foreground="#42D991"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="GEAR" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="GearText" Text="N" FontSize="22" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>

                <Border Margin="0,0,8,0" Background="{StaticResource HeroBrush}" BorderBrush="#1D4667" BorderThickness="1" CornerRadius="17" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="CURRENT DELIVERY" Foreground="#31A8FF" FontWeight="Bold" FontSize="12"/>
                            <Border Grid.Column="1" Background="#0B2943" BorderBrush="#1F5B87" BorderThickness="1" CornerRadius="8" Padding="11,6">
                                <TextBlock x:Name="JobStateText" Text="WAITING" Foreground="#78C6FF" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" x:Name="RouteText" Text="—   →   —" FontSize="29" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" x:Name="CargoText" Text="No active delivery" Foreground="#A5B8C9" FontSize="16" Margin="0,7,0,0" TextWrapping="Wrap"/>

                        <Grid Grid.Row="3" Margin="0,28,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="DISTANCE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="DistanceText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="JOB VALUE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="JobValueText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="DRIVER SHARE" Style="{StaticResource Eyebrow}"/><TextBlock Text="35%" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0" Foreground="#35AFFF"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="EST. PAY" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="DriverShareText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0" Foreground="#3EDB91"/></StackPanel>
                        </Grid>

                        <Border Grid.Row="4" Background="#07111B" BorderBrush="#173047" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,20,0,0">
                            <TextBlock Text="Live tracking is sampled locally 5 times per second and synchronized to Sterling every second" Foreground="#6F889E" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="8,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="DRIVER PROFILE" Foreground="#31A8FF" FontWeight="Bold" FontSize="12"/>
                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="28" Background="#102D46" BorderBrush="#199BFF" BorderThickness="2">
                                    <TextBlock Text="SL" FontSize="18" FontWeight="Bold" Foreground="#79C7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DriverNameText" Text="Not signed in" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DriverIdText" Text="—" Foreground="#8FA5B9" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="#183149" Margin="0,18,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="RANK" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="RankText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="CONNECTION" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="ConnectionText" Text="Offline" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="#35D68B"/></StackPanel>
                            </Grid>
                            <Border Background="#07131E" BorderBrush="#173148" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="ASSIGNED TRUCK" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="TruckText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,6,0">
                            <StackPanel><TextBlock Text="DRIVESCORE" Style="{StaticResource Eyebrow}"/><TextBlock Text="— / 100" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Calculated after live driving data" Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="14" Margin="6,0,0,0">
                            <StackPanel><TextBlock Text="TRACKER STATUS" Style="{StaticResource Eyebrow}"/><TextBlock Text="LIVE CLIENT" FontSize="20" FontWeight="SemiBold" Foreground="#3EDB91" Margin="0,7,0,0"/><TextBlock Text="Fast local refresh" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="Sterling Tracker is ready" Foreground="#657D94" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="STERLING LOGISTICS  •  BUILT ON TRUST  •  DRIVEN BY EXCELLENCE" Foreground="#425A70" FontSize="10"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
