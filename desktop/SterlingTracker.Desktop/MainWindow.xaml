<Window x:Class="SterlingTracker.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sterling Tracker" Height="680" Width="980" MinHeight="620" MinWidth="840" WindowStartupLocation="CenterScreen" Background="#07111F" Foreground="#F5F8FC">
<Window.Resources>
<Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="#0D1A2B"/><Setter Property="BorderBrush" Value="#1D3553"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#1688F8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
</Window.Resources>
<Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="STERLING" FontSize="31" FontWeight="Bold"/><TextBlock Text="LOGISTICS  •  OFFICIAL DRIVER TRACKER" Foreground="#75BFFF" FontSize="13" FontWeight="SemiBold" Margin="1,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="v1.1" VerticalAlignment="Center" Foreground="#7890AA"/></Grid>
<Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="● Sterling account not connected" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="AccountText" Text="Sign in with Discord to link your approved driver profile" Foreground="#9DB0C6" Margin="0,7,0,0"/><TextBlock x:Name="GameText" Text="ETS2 not detected" Foreground="#7890AA" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" x:Name="AccountButton" Content="Sign in with Discord" Click="AccountButton_Click" VerticalAlignment="Center"/></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width=".75*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="LIVE DRIVE" Foreground="#75BFFF" FontWeight="Bold"/><TextBlock x:Name="SpeedText" Text="0 mph" FontSize="48" FontWeight="Bold" Margin="0,18,0,12"/><TextBlock x:Name="TruckText" Text="Truck  —" FontSize="15"/><TextBlock x:Name="DamageText" Text="Damage  —" Margin="0,10,0,0"/><TextBlock x:Name="FuelText" Text="Fuel  —" Margin="0,10,0,0"/><TextBlock x:Name="TelemetryText" Text="Telemetry waiting" Foreground="#7890AA" Margin="0,20,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="CURRENT DELIVERY" Foreground="#75BFFF" FontWeight="Bold"/><TextBlock x:Name="CargoText" Text="No active delivery" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,10" TextWrapping="Wrap"/><TextBlock x:Name="RouteText" Text="—  →  —" FontSize="18" TextWrapping="Wrap"/><Separator Margin="0,20" Background="#1D3553"/><TextBlock x:Name="JobStateText" Text="Waiting for an ETS2 job" Foreground="#9DB0C6" TextWrapping="Wrap"/><TextBlock Text="Jobs  fuel stops  fines  incidents  mileage and driving time are sent automatically" Foreground="#7890AA" Margin="0,15,0,0" TextWrapping="Wrap"/></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="DRIVER" Foreground="#75BFFF" FontWeight="Bold"/><TextBlock x:Name="DriverNameText" Text="Not signed in" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,5" TextWrapping="Wrap"/><TextBlock x:Name="DriverIdText" Text="—" Foreground="#9DB0C6"/><Separator Margin="0,18" Background="#1D3553"/><TextBlock Text="RANK" Foreground="#7890AA" FontSize="11"/><TextBlock x:Name="RankText" Text="—" FontWeight="SemiBold" Margin="0,4,0,14"/><TextBlock Text="STATUS" Foreground="#7890AA" FontSize="11"/><TextBlock x:Name="ConnectionText" Text="Offline" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
</Grid>
<Grid Grid.Row="3" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterText" Text="Sterling Tracker is ready" Foreground="#7890AA" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Built for Sterling Logistics" Foreground="#536A82"/></Grid>
</Grid></Window>