<Window x:Class="SterlingTracker.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sterling Logistics Tracker" Height="620" Width="900" MinHeight="560" MinWidth="760" WindowStartupLocation="CenterScreen">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="STERLING LOGISTICS" FontSize="30" FontWeight="Bold"/><TextBlock Text="Official Driver Tracker" FontSize="16" Opacity=".7"/></StackPanel>
<Border Grid.Row="1" Margin="0,24,0,20" Padding="18" BorderThickness="1" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="● Connecting…" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="GameText" Text="Waiting for Euro Truck Simulator 2" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" x:Name="SettingsButton" Content="Tracker Key" Padding="18,8" Click="SettingsButton_Click"/></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Margin="0,0,10,0" Padding="20" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="LIVE DRIVE" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="SpeedText" Text="0 mph" FontSize="42" FontWeight="Bold" Margin="0,18,0,4"/><TextBlock x:Name="TruckText" Text="Truck: —"/><TextBlock x:Name="DamageText" Text="Damage: —" Margin="0,8,0,0"/><TextBlock x:Name="FuelText" Text="Fuel: —" Margin="0,8,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Margin="10,0,0,0" Padding="20" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="CURRENT DELIVERY" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="CargoText" Text="No active delivery" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,8" TextWrapping="Wrap"/><TextBlock x:Name="RouteText" Text="— → —" FontSize="18" TextWrapping="Wrap"/><Separator Margin="0,18"/><TextBlock Text="Sterling automatically tracks jobs, miles, fuel, fines, crashes and driver activity." TextWrapping="Wrap"/></StackPanel></Border></Grid>
<TextBlock Grid.Row="3" x:Name="FooterText" Text="Telemetry: http://localhost:6969  •  Sterling API connected through your private tracker key" Margin="0,22,0,0" Opacity=".65" TextWrapping="Wrap"/>
</Grid></Window>